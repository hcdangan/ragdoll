# Environment template for RAGdoll.
# Copy to `.env.local` for local development. Every value here is safe to commit:
# real secrets belong in the deployment environment, never in the repository.

# Base URL of the FastAPI engine.
#   local                  -> http://127.0.0.1:8000
#   Vercel (this project)  -> https://<deployment>/engine
RAGDOLL_API_URL=

# Shared secret between the Next.js bridge and the engine. Required on a hosted
# deployment: the engine refuses to start without it.
# Generate with: openssl rand -hex 32
RAGDOLL_API_TOKEN=

# 32+ characters. Signs the session cookie. Required in production.
# Generate with: openssl rand -hex 32
RAGDOLL_SESSION_SECRET=

# Upstash Redis / Vercel KV REST credentials. Effectively required on Vercel: the
# in-process session store is per-instance, so without these a session created on
# one instance is invisible to the next. The app says so out loud with a
# "No shared store" badge when they are missing.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Set to 1 on a hosted deployment so loopback and LAN providers fail fast with
# "Cannot reach localhost from a hosted deployment." Vercel sets this implicitly:
# both runtimes also treat VERCEL=1 as hosted, so you can leave it unset there.
RAGDOLL_HOSTED=0

# Engine-only: deterministic offline provider for local demos, E2E and CI. It is
# refused whenever the deployment is hosted, so it can never answer real questions.
RAGDOLL_DEV_PROVIDER=0

# Engine-only: faithfulness cut-off for the groundedness gate (default 0.5).
RAGDOLL_GROUNDEDNESS_THRESHOLD=0.5
