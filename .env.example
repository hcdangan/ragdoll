# Environment template for RAGdoll.
# Copy to `.env.local` for local development. Every value here is safe to commit:
# real secrets belong in the deployment environment, never in the repository.

# Base URL of the FastAPI engine.
#   local            -> http://127.0.0.1:8000
#   Vercel (same project) -> http://ragdoll-engine.internal:8000
RAGDOLL_API_URL=

# Shared secret between the Next.js bridge and the engine.
# Generate with: openssl rand -hex 32
RAGDOLL_API_TOKEN=

# 32+ characters. Signs and AES-256-GCM-seals the __Host-ragdoll-sid cookie,
# which also encrypts the provider API key the session carries.
# Generate with: openssl rand -hex 32
RAGDOLL_SESSION_SECRET=

# Optional Upstash Redis / Vercel KV REST credentials. Without them, sessions
# live in one Function instance; the bridge rebuilds the index transparently after
# a cold start, at the cost of an extra embed round-trip.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Set to 1 on a hosted deployment so loopback and LAN providers fail fast with
# "Cannot reach localhost from a hosted deployment."
RAGDOLL_HOSTED=0

# Engine-only: deterministic offline provider for local demos, E2E and CI. It is
# refused whenever RAGDOLL_HOSTED=1, so it can never answer real questions.
RAGDOLL_DEV_PROVIDER=0

# Engine-only: faithfulness cut-off for the groundedness gate (default 0.5).
RAGDOLL_GROUNDEDNESS_THRESHOLD=0.5
