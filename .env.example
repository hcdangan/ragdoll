# Environment template for RAGdoll.
# Copy to `.env.local` for local development. Every value here is safe to commit:
# real secrets belong in the deployment environment, never in the repository.

# 32+ characters. Signs the session cookie, and seals the provider API key that the
# session carries. Required in production.
# Generate with: openssl rand -hex 32
RAGDOLL_SESSION_SECRET=

# Upstash Redis / Vercel KV REST credentials. Effectively required on Vercel: the
# in-process session store is per-instance, so without these a session created on
# one instance is invisible to the next. The app says so out loud with a
# "No shared store" badge when they are missing.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Set to 1 on a hosted deployment so loopback and LAN providers fail fast with
# "Cannot reach localhost from a hosted deployment." Vercel sets this implicitly:
# the server also treats VERCEL=1 as hosted, so you can leave it unset there.
RAGDOLL_HOSTED=0

# Deterministic offline provider for local demos, tests and the E2E suite. It
# replaces the configured provider entirely, so never set it on a deployment that
# is meant to answer real questions.
RAGDOLL_DEV_PROVIDER=0

# Set to 1 to disable the jailbreak / prompt-injection input filter, for
# investigating a false positive without a redeploy.
RAGDOLL_DISABLE_GUARDRAILS=0
