{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "regions": ["sin1"],
  "functions": {
    "api/index.py": {
      "memory": 1024,
      "maxDuration": 300
    }
  },
  "experimentalServices": {
    "web": {
      "root": "web/",
      "framework": "nextjs",
      "buildCommand": "pnpm --filter @ragdoll/web build",
      "routes": [{ "src": "/(?!engine/).*", "dest": "/" }]
    },
    "ragdoll-engine": {
      "root": "api/",
      "entrypoint": "index:app",
      "routes": [{ "src": "/engine/(.*)", "dest": "/$1" }]
    }
  },
  "headers": [
    {
      "source": "/brand/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
